# Copy this file to .env. Never commit secrets.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
PORT=8000
DATABASE_URL=sqlite:///flowpilot.db
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeThis-Immediately-123!
COOKIE_SECURE=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used by Docker Compose; replace with a long random password.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
